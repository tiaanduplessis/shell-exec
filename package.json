{
  "name": "shell-exec",
  "version": "1.1.2",
  "description": "A tiny cross-platform promise based wrapper around child_process.spawn.",
  "license": "MIT",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "repository": {
    "url": "https://github.com/tiaanduplessis/shell-exec",
    "type": "git"
  },
  "homepage": "https://github.com/tiaanduplessis/shell-exec#readme",
  "bugs": {
    "url": "https://github.com/tiaanduplessis/shell-exec/issues"
  },
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "rm -rf dist && tsup src/index.ts --format cjs,esm --dts --target node12 && node scripts/copy-types.js",
    "prepublishOnly": "pnpm run build",
    "types:check": "tsc --noEmit",
    "format": "pretty-quick --ignore-path .gitignore",
    "start": "tsx example.ts",
    "test:package": "npm run build && node scripts/test-package.js"
  },
  "keywords": [
    "shell-exec",
    "shell",
    "sh",
    "exec"
  ],
  "author": "Tiaan du Plessis",
  "devDependencies": {
    "@types/jest": "^27.4.0",
    "@types/node": "^17.0.15",
    "prettier": "^2.6.2",
    "pretty-quick": "^3.1.3",
    "tsup": "^5.12.8",
    "tsx": "^3.1.0",
    "typescript": "^4.7.4",
    "vitest": "^0.12.6"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./dist": "./dist/index.js",
    "./dist/index": "./dist/index.js",
    "./dist/index.js": "./dist/index.js",
    "./dist/index.mjs": "./dist/index.mjs",
    "./dist/index.d.ts": "./dist/index.d.ts",
    "./dist/index.d.mts": "./dist/index.d.mts",
    "./package.json": "./package.json",
    "./README.md": "./README.md",
    "./LICENSE": "./LICENSE",
    "./package": "./package.json"
  }
}
